{
  "name": "explainer-lab",
  "version": "1.0.0",
  "private": true,
  "description": "A reusable template for interactive, step-by-step explainers. Ships with Protocol Explorer as a custom system plus data-driven sample explainers.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate": "tsc -p tsconfig.validate.json && node .cache/validate/scripts/validate-explainers.js",
    "new:explainer": "node scripts/new-explainer.mjs",
    "check": "npm run typecheck && npm run validate"
  },
  "dependencies": {
    "next": "^16.2.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0"
  }
}
